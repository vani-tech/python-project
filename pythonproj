
import os
import zipfile

project = "hr-management-system"

files = {

    # ---------------- APP ----------------
    f"{project}/app.py": """
from flask import Flask, request, session, redirect
import sqlite3

app = Flask(__name__)
app.secret_key = "hr_secret"

# ---------------- DB CONNECTION ----------------
def get_connection():
    return sqlite3.connect("hr.db", check_same_thread=False)

# ---------------- DB INIT ----------------
def init_db():
    conn = get_connection()
    c = conn.cursor()

    c.execute('''
    CREATE TABLE IF NOT EXISTS employees (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT,
        role TEXT,
        salary INTEGER
    )
    ''')

    c.execute('''
    CREATE TABLE IF NOT EXISTS attendance (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        emp_id INTEGER,
        status TEXT
    )
    ''')

    conn.commit()
    conn.close()

init_db()

# ---------------- LOGIN ----------------
@app.route("/", methods=["GET", "POST"])
def login():

    if request.method == "POST":

        username = request.form.get("username")
        password = request.form.get("password")

        if username == "admin" and password == "admin":
            session["user"] = "admin"
            return redirect("/dashboard")

        return "Invalid credentials"

    return '''
    <h2>Login</h2>

    <form method="POST">

        <input name="username" placeholder="Username"><br><br>

        <input name="password" type="password"
               placeholder="Password"><br><br>

        <button type="submit">Login</button>

    </form>
    '''

# ---------------- DASHBOARD ----------------
@app.route("/dashboard")
def dashboard():

    if "user" not in session:
        return redirect("/")

    return '''
    <h1>HR Dashboard</h1>

    <a href="/employees">Employees</a><br><br>

    <a href="/attendance">Attendance</a><br><br>

    <a href="/logout">Logout</a>
    '''

# ---------------- EMPLOYEES ----------------
@app.route("/employees", methods=["GET", "POST"])
def employees():

    conn = get_connection()
    c = conn.cursor()

    if request.method == "POST":

        name = request.form.get("name")
        role = request.form.get("role")
        salary = request.form.get("salary")

        c.execute(
            "INSERT INTO employees(name, role, salary) VALUES (?, ?, ?)",
            (name, role, salary)
        )

        conn.commit()

    data = c.execute("SELECT * FROM employees").fetchall()

    conn.close()

    return str(data)

# ---------------- ATTENDANCE ----------------
@app.route("/attendance", methods=["GET", "POST"])
def attendance():

    conn = get_connection()
    c = conn.cursor()

    if request.method == "POST":

        emp_id = request.form.get("emp_id")
        status = request.form.get("status")

        c.execute(
            "INSERT INTO attendance(emp_id, status) VALUES (?, ?)",
            (emp_id, status)
        )

        conn.commit()

    data = c.execute("SELECT * FROM attendance").fetchall()

    conn.close()

    return str(data)

# ---------------- LOGOUT ----------------
@app.route("/logout")
def logout():

    session.clear()

    return redirect("/")

# ---------------- START APP ----------------
if __name__ == "__main__":

    app.run(
        host="0.0.0.0",
        port=5000,
        debug=True
    )
""",

    # ---------------- REQUIREMENTS ----------------
    f"{project}/requirements.txt": """
flask
""",

    # ---------------- README ----------------
    f"{project}/README.md": """
# HR MANAGEMENT SYSTEM

Features:
- Login system
- Employee management
- Attendance system
- Salary tracking

## Run locally

pip install -r requirements.txt

python app.py
"""
}

# ---------------- CREATE FILES ----------------
for path, content in files.items():

    os.makedirs(os.path.dirname(path), exist_ok=True)

    with open(path, "w", encoding="utf-8") as f:
        f.write(content.strip())

print("✅ Project created")

# ---------------- CREATE ZIP ----------------
zip_name = project + ".zip"

with zipfile.ZipFile(zip_name, "w", zipfile.ZIP_DEFLATED) as zipf:

    for root, dirs, fs in os.walk(project):

        for file in fs:

            file_path = os.path.join(root, file)

            zipf.write(file_path)

print("📦 ZIP READY:", zip_name)

